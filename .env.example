# Required for web/mobile Supabase access.
#
# Vercel: Settings → Environment Variables → Production (and Preview if needed), then redeploy
# after changes (`npm run build:web` bakes these in via app.config.js → extra).
#
# Primary names (case-sensitive):
Supabase_URL=https://your-project-ref.supabase.co
Supabase_Publishable_Key=sb_publishable_xxx
#
# Aliases also supported:
# EXPO_PUBLIC_SUPABASE_URL=...
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=...
# SUPABASE_URL=...  +  SUPABASE_ANON_KEY=...

# Optional. Auth redirects use the browser's current origin on web (so Preview + Production work).
# In Supabase → Authentication → URL Configuration, add Redirect URLs for every host you use, e.g.:
#   https://your-app.vercel.app/**
#   https://your-preview-*.vercel.app/**  (if your Supabase plan supports wildcards)
EXPO_PUBLIC_SITE_URL=https://your-app.vercel.app

# Optional Google Auth client IDs (leave blank if not using Google sign-in).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
