# =============================================================================
# Spotter — required environment variables
# =============================================================================
# Optional pilot: EXPO_PUBLIC_SENTRY_DSN to enable web error reporting.
#
# These are baked into the static web bundle at build time via app.config.js
# (Metro only inlines EXPO_PUBLIC_* names automatically; the canonical
# `Supabase_*` names are surfaced through `extra` in app.config.js).
#
# In Vercel: Project Settings -> Environment Variables, add for Production
# (and Preview if you want preview deploys to work), then redeploy.
# Production builds hard-fail if these are missing — see app.config.js.

# --- Supabase (REQUIRED) -----------------------------------------------------
Supabase_URL=https://your-project-ref.supabase.co
Supabase_Publishable_Key=sb_publishable_xxx

# Aliases also accepted (any one of each group is enough):
#   EXPO_PUBLIC_SUPABASE_URL
#   EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY / EXPO_PUBLIC_SUPABASE_ANON_KEY
#   SUPABASE_URL
#   SUPABASE_ANON_KEY / SUPABASE_PUBLISHABLE_KEY

# --- Site URL (OPTIONAL, native + SSR only) ----------------------------------
# Web auth and league invites use `window.location.origin` automatically — so
# Production, Preview (*.vercel.app) and custom domains all work without this.
# Set it only for native builds, or to give server-side rendering a sensible
# default base URL. In Supabase → Authentication → URL Configuration also add:
#   https://your-app.vercel.app/**
#   https://*-your-team.vercel.app/**  (Preview wildcard, if plan supports it)
EXPO_PUBLIC_SITE_URL=https://your-app.vercel.app

# --- Fail-on-missing-env override (OPTIONAL) ---------------------------------
# Vercel production builds already hard-fail when Supabase env is missing.
# Set this to force the same hard-fail locally (`npm run build:web`):
# EXPO_PUBLIC_FAIL_ON_MISSING_ENV=true

# --- Release tagging (Vercel injects automatically; override only if needed) -
# EXPO_PUBLIC_RELEASE_SHA=$VERCEL_GIT_COMMIT_SHA

# --- Error reporting (OPTIONAL) ---------------------------------------------
# If set, web crashes + unhandled rejections are forwarded to Sentry via HTTP.
# When unset, errors only land in the browser console.
# EXPO_PUBLIC_SENTRY_DSN=https://public@oXXXX.ingest.sentry.io/PROJECT_ID

# --- Admin scripts only — NEVER add to Vercel ---------------------------------
# Required by scripts/seed-breeds.mjs, scripts/fetch-breed-photos.mjs,
# scripts/restore-scans-from-storage.mjs. Keep in a local .env that is gitignored.
# SUPABASE_SERVICE_ROLE_KEY=
