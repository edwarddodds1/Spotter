{
  "expo": {
    "name": "Spotter",
    "slug": "spotter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/spotter-logo.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "spotter",
    "splash": {
      "image": "./assets/spotter-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0b0b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spotter.dog",
      "buildNumber": "2",
      "icon": "./assets/icon-ios.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Spotter uses your camera so you can photograph dogs you encounter.",
        "NSLocationWhenInUseUsageDescription": "Spotter uses your location to place scans on your journal map and calculate area leagues.",
        "NSPhotoLibraryUsageDescription": "Spotter uses your photo library when you choose an avatar."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/spotter-logo.png",
        "backgroundColor": "#0b0b0b"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.spotter.dog",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/spotter-logo.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Spotter uses your camera so you can photograph dogs you encounter.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Spotter uses your photos when you choose an avatar."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Spotter uses your location to place scans on your journal map and calculate area leagues."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "659f39cf-8af6-4bd5-9c5d-ba7478eac60d"
      }
    },
    "owner": "edwarddodds"
  }
}
